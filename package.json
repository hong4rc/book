{
  "name": "book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Searchable static catalog of Vietnamese public-domain ebooks",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "fixtures": "node scripts/check-fixtures.mjs",
    "test": "npm run fixtures && npm run validate",
    "ingest": "node scripts/ingest.mjs",
    "facets": "node scripts/derive-facets.mjs",
    "build": "node scripts/build-index.mjs",
    "refresh": "npm run ingest && npm run facets && npm run validate && npm run build",
    "serve": "npx --yes serve site"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.3"
  },
  "license": "MIT"
}
